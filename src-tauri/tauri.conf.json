{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HB Scrub",
  "version": "1.4.0",
  "identifier": "org.honeybadger.hb-scrub",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../dist/**/*"
    ],
    "icon": [
      "../electron/assets/icon_256x256.png"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
